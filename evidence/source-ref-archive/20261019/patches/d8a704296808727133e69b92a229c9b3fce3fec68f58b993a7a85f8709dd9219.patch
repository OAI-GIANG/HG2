+
+    def test_missing_runtime_identity_is_fail_closed_and_not_recreated(self):
+        s, d = build()
+        p = os.path.join(d, "runtime_id")
+        os.remove(p)
+        self.assertEqual(s.verify()["reason"], "runtime_identity_missing")
+        with self.assertRaises(HistoryError):
