diff --git a/.circleci/config.yml b/.circleci/config.yml
new file mode 100644
index 0000000..d8b5d65
--- /dev/null
+++ b/.circleci/config.yml
@@ -0,0 +1,30 @@
+version: 2.1
+
+jobs:
+  verify:
+    docker:
+      - image: cimg/python:3.12
+    steps:
+      - checkout
+      - run:
+          name: Record revision and verify clean checkout
+          command: |
+            set -eu
+            printf 'CIRCLE_SHA1=%s\n' "${CIRCLE_SHA1:-unknown}"
+            printf 'HEAD=%s\n' "$(git rev-parse HEAD)"
+            test -z "$(git status --porcelain)"
+      - run:
+          name: Check patch whitespace
+          command: |
+            set -eu
+            git diff --check HEAD^ HEAD
+      - run:
+          name: Run complete unittest suite with resource warnings enabled
+          command: |
+            set -eu
+            PYTHONDONTWRITEBYTECODE=1 python -W default -m unittest discover -s tests -v
+
+workflows:
+  hg2-p0-v3-verify:
+    jobs:
+      - verify
