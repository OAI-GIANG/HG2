+        manifest = json.loads((ROOT / "manifest.json").read_text(encoding="utf-8"))
+        self.assertNotIn("hg.creative_assimilation", manifest.get("modules", []))
+        self.assertNotIn("hg.creative_assimilation", manifest.get("optional_modules", []))
