+class LifecycleTests(unittest.TestCase):
+    def setUp(self):
+        self.sources = {"a": source(), "b": source("b", SHA_B, COMMIT_B)}
+        self.principles = principles()
+    def test_draft_to_candidate_structurally_complete(self):
+        c = candidate(trust=TrustAssessment())
+        out = transition(c, "CANDIDATE", actor_id="author", sources=self.sources, principles=self.principles)
+        self.assertEqual(out.lifecycle_status, "CANDIDATE"); self.assertEqual(out.revision, 2)
+    def test_candidate_can_be_accepted_without_intermediate_review_state(self):
+        c = candidate(lifecycle_status="CANDIDATE")
+        out = transition(c, "ACCEPTED", actor_id="owner", sources=self.sources, principles=self.principles, evidence_refs=("decision:technical-evidence",))
+        self.assertEqual(out.lifecycle_status, "ACCEPTED")
+        self.assertEqual(out.revision, c.revision + 1)
+    def test_acceptance_still_requires_complete_provenance_and_trust(self):
+        c = candidate(lifecycle_status="CANDIDATE", trust=TrustAssessment())
+        with self.assertRaisesRegex(ValueError, "ACCEPTANCE_GATE_BLOCKED"):
+            transition(c, "ACCEPTED", actor_id="owner", sources=self.sources, principles=self.principles, evidence_refs=("decision:technical-evidence",))
+    def test_acceptance_requires_technical_evidence_reference(self):
+        with self.assertRaisesRegex(ValueError, "ACCEPTANCE_EVIDENCE_REQUIRED"):
+            transition(candidate(lifecycle_status="CANDIDATE"), "ACCEPTED", actor_id="owner", sources=self.sources, principles=self.principles)
+    def test_revoke_requires_evidence(self):
+        with self.assertRaisesRegex(ValueError, "DECISION_EVIDENCE_REQUIRED"):
+            transition(candidate(lifecycle_status="ACCEPTED"), "REVOKED", actor_id="governance", sources=self.sources, principles=self.principles)
+    def test_rejected_record_cannot_reopen(self):
+        with self.assertRaisesRegex(ValueError, "TRANSITION_NOT_ALLOWED"):
+            transition(candidate(lifecycle_status="REJECTED"), "CANDIDATE", actor_id="author", sources=self.sources, principles=self.principles)
+
+if __name__ == "__main__": unittest.main()
