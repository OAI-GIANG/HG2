  "finding": {
    "id": "F-01",
    "severity": "HIGH",
    "root_cause": "POST /api/ask wrote model.call.completed after the provider response but did not persist the required redacted start event before calling the provider.",
    "change": "hg/server.py now appends model.call.started to the canonical StateStore before ModelGateway.ask. If the start-event append raises, the synthesis adapter returns BLOCKED/PRECALL_AUDIT_WRITE_FAILED and the provider adapter is not invoked.",
    "negative_test": "tests/test_server.py::ServerTests.test_ask_fails_closed_when_precall_audit_write_fails",
    "positive_test": "tests/test_server.py::ServerTests.test_ask_uses_authorized_context_and_audits_call",
    "status": "TESTED_IN_LOCAL_TEST_RUNTIME",
    "limitations": [
      "A deterministic fake gateway validates the call boundary; this does not prove a deployed runtime or live-provider behavior.",
      "The start event contains digests and request/plan identifiers, not the raw query.",
      "A successful provider response remains RESPONSE_ONLY; aggregate API status remains PARTIAL rather than implying external action completion."
    ]
  },
