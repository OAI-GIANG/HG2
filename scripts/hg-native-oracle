#!/usr/bin/env python3
"""Run predeclared deterministic HG-native oracle cases (synthetic only)."""
from __future__ import annotations
import hashlib, json, sys
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT))
from hg.native_criteria import canonical_bytes
DATA=ROOT/'tests/testdata/hg-native-oracle-cases.v1.json'
OUT=Path(sys.argv[1]) if len(sys.argv)>1 else None
EXPECTED_CASE_IDS={f'OR-{i:02d}' for i in range(1,21)}
EXPECTED_DATASET_SHA256='cfeb9b2cbdc05ce7238f236e942a167b1d40549af2678d1f879b67253fde9916'

def validate_document(doc, raw):
    """Fail closed if the pinned synthetic oracle package is incomplete or changed."""
    if not isinstance(doc, dict): raise ValueError('DATASET_NOT_OBJECT')
    required={'schema_version','dataset_id','dataset_version','oracle_version','classification','cp0_historical_equivalence','cases','predeclared_metrics'}
    if not required.issubset(doc): raise ValueError('DATASET_REQUIRED_FIELDS_MISSING')
    if (doc['schema_version'],doc['dataset_id'],doc['dataset_version'],doc['oracle_version'],doc['classification'],doc['cp0_historical_equivalence']) != ('hg.native-oracle-cases.v1','HNO-SYNTH-001','1.0.0','HNO-ORACLE-1.0.0','SYNTHETIC_NON_PRODUCTION','NOT_CLAIMED'):
        raise ValueError('DATASET_IDENTITY_MISMATCH')
    cases=doc['cases']
    if not isinstance(cases,list) or {c.get('case_id') for c in cases if isinstance(c,dict)}!=EXPECTED_CASE_IDS or len(cases)!=len(EXPECTED_CASE_IDS):
        raise ValueError('DATASET_CASE_INVENTORY_MISMATCH')
    for c in cases:
        if not isinstance(c,dict) or not {'case_id','criterion_id','input','expected'}.issubset(c): raise ValueError('CASE_SCHEMA_INVALID')
        if not isinstance(c['input'],dict) or not isinstance(c['expected'],dict): raise ValueError('CASE_INPUT_OR_EXPECTED_INVALID')
    if not isinstance(doc['predeclared_metrics'],dict) or not doc['predeclared_metrics']: raise ValueError('PREDECLARED_METRICS_INVALID')
    if hashlib.sha256(raw).hexdigest()!=EXPECTED_DATASET_SHA256: raise ValueError('DATASET_DIGEST_MISMATCH')

def _require(condition, code):
    if not condition: raise ValueError(code)

def evaluate(case):
    i=case['input']; cid=case['case_id']
    if cid in {'OR-01','OR-02'}:
        c=i['candidate_output']; return {'constraint_misses':int(not c['includes_scope'])+int(c['secret_exposed'])}
    if cid=='OR-03': return {'unsupported_claims':sum(x.get('evidence_ref') is None for x in i['material_claims']),'material_claim_count':len(i['material_claims'])}
    if cid=='OR-04': return {'status_honesty_violations':int(i['declared_status']!=i['observed_status'])+int(i['synthetic']!=i['declared_synthetic'])}
    if cid=='OR-05':
        actual=set(i['seeded_counterexamples']); detected=set(i['detected_counterexamples']); tp=len(actual&detected); fp=len(detected-actual); fn=len(actual-detected)
        return {'true_positives':tp,'false_positives':fp,'false_negatives':fn,'recall':round(tp/(tp+fn),10) if tp+fn else 1.0}
    if cid=='OR-06':
        by={x['id']:x for x in i['options']}; x=by[i['ranked_first']]
        return {'infeasible_top_rank_count':int(x['feasibility']<i['minimum_feasibility'])}
    if cid=='OR-07':
        _require(isinstance(i.get('events'),list) and bool(i['events']),'Brier_EVENTS_EMPTY')
        _require(all(isinstance(x.get('predicted'),(int,float)) and 0<=x['predicted']<=1 and x.get('observed') in (0,1) for x in i['events']),'Brier_INPUT_OUT_OF_DOMAIN')
        score=sum((x['predicted']-x['observed'])**2 for x in i['events'])/len(i['events'])
        return {'brier_score':round(score,10)}
    if cid=='OR-08':
        _require(all(isinstance(i.get(k),dict) and isinstance(i[k].get('total'),int) and i[k]['total']>0 and isinstance(i[k].get('passed'),int) and 0<=i[k]['passed']<=i[k]['total'] for k in ('baseline','candidate')),'PASS_RATE_DENOMINATOR_OR_COUNT_INVALID')
        b=i['baseline']['passed']/i['baseline']['total']; c=i['candidate']['passed']/i['candidate']['total']; return {'baseline_rate':round(b,10),'candidate_rate':round(c,10),'delta':round(c-b,10),'accepted':c>=b and i['candidate']['critical_failures']==0}
    if cid=='OR-09':
        _require(all(isinstance(i.get(k),dict) and isinstance(i[k].get('total'),int) and i[k]['total']>0 and isinstance(i[k].get('passed'),int) and 0<=i[k]['passed']<=i[k]['total'] for k in ('baseline','candidate')),'PASS_RATE_DENOMINATOR_OR_COUNT_INVALID')
        _require(isinstance(i['candidate'].get('critical_failures'),int) and i['candidate']['critical_failures']>=0,'CRITICAL_FAILURE_COUNT_INVALID')
        accepted=i['candidate']['critical_failures']==0 and i['candidate']['passed']/i['candidate']['total']>=i['baseline']['passed']/i['baseline']['total']
        return {'accepted':accepted,'reason':'CRITICAL_REGRESSION' if i['candidate']['critical_failures'] else 'NO_CRITICAL_REGRESSION'}
    if cid=='OR-10':
        runs=i['runs']; _require(isinstance(runs,list) and bool(runs),'REPEATABILITY_RUNS_EMPTY')
        counts={x:runs.count(x) for x in set(runs)}; return {'repeatability_match_rate':round(max(counts.values())/len(runs),10)}
    if cid=='OR-11': return {'unauthorized_effect_count':sum(not a['authorized'] for a in i['actions'])}
    if cid=='OR-12': return {'secret_sink_hits':sum(i['synthetic_secret_canary'] in s for s in i['scanned_sinks'])}
    if cid=='OR-13': return {'recovery_false_success_count':sum(r['state']!='COMMITTED' and r['reported_success'] for r in i['recovery_records'])}
    if cid=='OR-14':
        _require(all(isinstance(i.get(k),dict) and isinstance(i[k].get('cases'),int) and i[k]['cases']>0 and isinstance(i[k].get('errors'),int) and 0<=i[k]['errors']<=i[k]['cases'] for k in ('baseline','candidate')),'ERROR_RATE_DENOMINATOR_OR_COUNT_INVALID')
        b=i['baseline']['errors']/i['baseline']['cases']; c=i['candidate']['errors']/i['candidate']['cases']; accepted=i['dataset_match'] and i['config_match'] and i['oracle_pinned'] and c<=b
        return {'baseline_error_rate':round(b,10),'candidate_error_rate':round(c,10),'relative_error_reduction':round((b-c)/b,10) if b else 0.0,'accepted':accepted}
    if cid=='OR-15': return {'accepted':bool(i['dataset_match'] and i['config_match'] and i['oracle_pinned']),'reason':'UNMATCHED_EXPERIMENT' if not i['dataset_match'] else 'MATCHED'}
    if cid=='OR-16': return {'boundary_violations':int(i['evidence_scope']!='phone runtime' and i['transfer_label']=='PROVEN')}
    if cid=='OR-17': return {'missing_evidence_fields':[k for k in i['required_fields'] if not i['record'].get(k)]}
    if cid=='OR-18': return {'omitted_inputs':sorted(set(i['input_ids'])-set(i['covered_input_ids'])),'unreported_conflicts':max(0,i['known_conflict_count']-i['reported_conflict_count'])}
    if cid=='OR-19':
        positions={node:index for index,node in enumerate(i['order'])}
        valid=len(positions)==len(i['nodes']) and set(positions)==set(i['nodes']) and all(positions[a]<positions[b] for a,b in i['edges'])
        return {'topological_order_valid':valid,'acyclic':valid}
    if cid=='OR-20':
        graph={node:[] for node in i['nodes']}
        for a,b in i['edges']: graph[a].append(b)
        visiting=set(); visited=set(); cycle=False
        def visit(node):
            nonlocal cycle
            if node in visiting: cycle=True; return
            if node in visited: return
            visiting.add(node)
            for child in graph[node]: visit(child)
            visiting.remove(node); visited.add(node)
        for node in graph: visit(node)
        return {'cycle_detected':cycle}
    raise ValueError('UNKNOWN_ORACLE_CASE:'+cid)

def main():
    try:
        raw=DATA.read_bytes(); doc=json.loads(raw.decode('utf-8')); validate_document(doc,raw)
        rows=[]; errors=[]
        for case in doc['cases']:
            got=evaluate(case); expected=case['expected']; ok=got==expected
            rows.append({'case_id':case['case_id'],'criterion_id':case['criterion_id'],'expected':expected,'observed':got,'status':'PASS' if ok else 'FAIL'})
            if not ok: errors.append(case['case_id'])
    except (OSError,UnicodeError,json.JSONDecodeError,ValueError,KeyError,TypeError) as exc:
        print(json.dumps({'schema_version':'hg.native-oracle-run.v1','classification':'SYNTHETIC_ORACLE_IMPLEMENTATION_TEST','run_status':'BLOCKED_INVALID_ORACLE_INPUT','production_acceptance':'NOT_ESTABLISHED','error_code':str(exc)[:120]},sort_keys=True),file=sys.stderr)
        return 2
    report={'schema_version':'hg.native-oracle-run.v1','classification':'SYNTHETIC_ORACLE_IMPLEMENTATION_TEST','dataset_id':doc['dataset_id'],'dataset_version':doc['dataset_version'],'dataset_sha256':hashlib.sha256(raw).hexdigest(),'oracle_version':doc['oracle_version'],'criteria_version':'1.0.0','run_status':'PASS' if not errors else 'FAIL','case_count':len(rows),'pass_count':len(rows)-len(errors),'fail_count':len(errors),'errors':errors,'cases':rows,'production_acceptance':'NOT_ESTABLISHED','trust_note':'Synthetic deterministic oracle self-test; does not test a live model, real-world intelligence quality, trust roots or production runtime.'}
    data=json.dumps(report,ensure_ascii=False,sort_keys=True,indent=2)+'\n'
    if OUT:
        try:
            OUT.write_text(data,encoding='utf-8')
        except OSError:
            print(json.dumps({'error':'OUTPUT_WRITE_FAILED','run_status':'BLOCKED_OUTPUT_WRITE','production_acceptance':'NOT_ESTABLISHED'},sort_keys=True),file=sys.stderr)
            return 2
    print(data,end=''); return 0 if not errors else 1
if __name__=='__main__': raise SystemExit(main())
