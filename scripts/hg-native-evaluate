#!/usr/bin/env python3
"""Print the authored HG-native rubric or evaluate recorded observations."""
from __future__ import annotations
import argparse
import json
import sys
from pathlib import Path
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from hg.native_criteria import aggregate_observations, criteria_document, validate_criteria_document

def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--criteria", action="store_true", help="emit the versioned native rubric")
    parser.add_argument("--observations", type=Path, help="evaluate an observation JSON array")
    args = parser.parse_args()
    if args.criteria == bool(args.observations):
        parser.error("choose exactly one of --criteria or --observations")
    if args.criteria:
        doc = criteria_document()
        validate_criteria_document(doc)
        result = doc
    else:
        raw = args.observations.read_bytes()
        if len(raw) > 512_000:
            print(json.dumps({"error":"INPUT_TOO_LARGE"}), file=sys.stderr)
            return 2
        try:
            observations = json.loads(raw.decode("utf-8"))
            if type(observations) is not list:
                raise ValueError("OBSERVATIONS_MUST_BE_ARRAY")
            result = aggregate_observations(observations)
        except (ValueError, UnicodeError, json.JSONDecodeError) as exc:
            print(json.dumps({"error":"INVALID_OBSERVATIONS", "detail":str(exc)}, ensure_ascii=False), file=sys.stderr)
            return 2
    print(json.dumps(result, ensure_ascii=False, sort_keys=True, indent=2))
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
