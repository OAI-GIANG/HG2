#!/usr/bin/env python3
"""Validate the HNI-30 oracle or aggregate a versioned evidence bundle."""
from __future__ import annotations
import argparse
import json
import sys
from pathlib import Path
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from hg.hni30_evaluator import load_bundle, load_oracle, evaluate_bundle, validate_oracle


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--oracle", type=Path, default=ROOT / "docs/HNI30-EVALUATOR-ORACLE-V1.json")
    parser.add_argument("--criteria", type=Path, default=ROOT / "docs/HG-NATIVE-INTELLIGENCE-CRITERIA-DRAFT-V1.md")
    parser.add_argument("--validate-oracle", action="store_true")
    parser.add_argument("--bundle", type=Path)
    parser.add_argument("--evidence-root", type=Path, default=ROOT)
    args = parser.parse_args()
    if args.validate_oracle == bool(args.bundle):
        parser.error("choose exactly one of --validate-oracle or --bundle")
    try:
        oracle = load_oracle(args.oracle, args.criteria)
        if args.validate_oracle:
            result = validate_oracle(oracle, args.criteria)
            result["runtime_approval"] = "NOT_APPROVED"
            result["runtime_execution"] = "NOT_RUN"
        else:
            result = evaluate_bundle(load_bundle(args.bundle), oracle, args.criteria, args.evidence_root)
    except (OSError, ValueError) as exc:
        print(json.dumps({"evaluation_status": "BLOCKED", "error": str(exc)}, sort_keys=True), file=sys.stderr)
        return 2
    print(json.dumps(result, ensure_ascii=False, sort_keys=True, indent=2))
    return 0 if result.get("evaluation_status") in {"PASS", "SYNTHETIC_ONLY"} or result.get("valid") else 1


if __name__ == "__main__":
    raise SystemExit(main())
