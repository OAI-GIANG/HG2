+_HG_RUNTIME_PROCESS_STARTED_EPOCH = time.time()
+_HG_RUNTIME_SOURCE_SHA256_AT_START = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
+_HG2_ROUTE_TOKEN_PATH = Path.home() / ".config" / "hg" / "capabilities" / "github_hg2_public_read.route_token"
+
+
+def _hg2_route_authorized(handler):
+    """Require a PHONE-local bearer token for the loopback connector endpoint."""
+    try:
+        if not ipaddress.ip_address(str(handler.client_address[0])).is_loopback:
+            return False
+        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
+        fd = os.open(_HG2_ROUTE_TOKEN_PATH, flags)
+        try:
+            info = os.fstat(fd)
+            if not __import__("stat").S_ISREG(info.st_mode) or info.st_uid != os.getuid():
+                return False
+            if (info.st_mode & 0o077) or info.st_size > 512:
+                return False
+            expected = os.read(fd, 513).decode("utf-8").strip()
+        finally:
+            os.close(fd)
+        supplied = str(handler.headers.get("Authorization", ""))
+        if not supplied.startswith("Bearer "):
+            return False
+        provided = supplied[7:]
+        return bool(expected) and hmac.compare_digest(expected, provided)
+    except Exception:
+        return False
+
